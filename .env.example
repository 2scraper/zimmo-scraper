# Copy this file to .env and fill in real values.
# A copied placeholder value below is treated as UNSET by env_config.py --
# see its own module docstring for the full precedence rules
# (explicit CLI flag > exported environment variable > this file > default).
#
# This file's variable set must exactly match env_config.py's ENV_KEYS --
# tests/test_smoke.py asserts the two are equal in both directions.

# Shared across the whole 2scraper family -- your 2captcha.com API key.
TWOCAPTCHA_KEY=your_2captcha_key_here

# Per-site variables (zimmo-scraper specific):
ZIMMO_URL=https://www.zimmo.be/nl/gent-9000/te-koop/
ZIMMO_CDP_ENDPOINT=ws://user:pass@host:port
ZIMMO_PROXY=http://user:pass@host:port
